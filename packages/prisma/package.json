{
  "name": "@hibari/prisma",
  "version": "0.0.0",
  "private": true,
  "description": "Prisma ORM driver adapter for Hibari.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "generate:test-client": "prisma generate --schema test/fixtures/prisma/schema.prisma",
    "test": "npm run build && node --test test/sql.test.mjs && npm run generate:test-client && node --import tsx --test test/prisma-client.test.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@hibari/core": "0.0.0",
    "@prisma/driver-adapter-utils": "7.9.1"
  },
  "devDependencies": {
    "@prisma/client": "7.9.1",
    "prisma": "7.9.1",
    "tsx": "4.23.12",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
